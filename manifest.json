{
  "manifest_version": 3,
  "name": "Slop Filterer",
  "version": "1.1",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Slop Filterer"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*"],
      "css": ["hide-shorts.css"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}