{
  "manifest_version": 3,
  "name": "Slop Filterer",
  "version": "1.1",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Slop Filterer",
    "default_icon": "icon.png"
  },
  "permissions": ["storage", "scripting", "tabs"],
  "host_permissions": [
    "*://www.youtube.com/*",
    "*://www.instagram.com/*",
    "*://www.tiktok.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}